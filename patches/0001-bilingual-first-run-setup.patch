@@ -46,0 +54,56 @@ welcome_dialog::welcome_dialog(std::shared_ptr<gui_settings> gui_settings, bool
+	auto* setup_group = new QGroupBox(tr("Quick setup / الإعداد السريع"), this);
+	auto* setup_layout = new QVBoxLayout(setup_group);
+	auto* setup_description = new QLabel(
+		tr("Install firmware, add your own game folder, then configure a controller using RPCS3's existing tools.")
+		+ QStringLiteral("<br/><span dir=\"rtl\">ثبّت البرنامج الثابت، أضف مجلد ألعابك، ثم أعد إعداد وحدة التحكم باستخدام أدوات RPCS3 الأصلية.</span>"),
+		setup_group);
+	setup_description->setWordWrap(true);
+	setup_description->setTextFormat(Qt::RichText);
+	setup_layout->addWidget(setup_description);
+
+	auto* setup_buttons = new QHBoxLayout();
+	auto* firmware_button = new QPushButton(tr("Install firmware / تثبيت البرنامج الثابت"), setup_group);
+	auto* games_button = new QPushButton(tr("Add game folder / إضافة مجلد ألعاب"), setup_group);
+	auto* controller_button = new QPushButton(tr("Configure controller / إعداد التحكم"), setup_group);
+	setup_buttons->addWidget(firmware_button);
+	setup_buttons->addWidget(games_button);
+	setup_buttons->addWidget(controller_button);
+	setup_layout->addLayout(setup_buttons);
+
+	auto* sony_link = new QLabel(
+		QStringLiteral("<a href=\"https://www.playstation.com/ar-sa/support/hardware/ps3/system-software/\">")
+		+ tr("Official Sony firmware page / صفحة سوني الرسمية") + QStringLiteral("</a>"),
+		setup_group);
+	sony_link->setTextFormat(Qt::RichText);
+	sony_link->setOpenExternalLinks(true);
+	setup_layout->addWidget(sony_link);
+
+	const int logical_processors = QThread::idealThreadCount();
+	const QString cpu_summary = logical_processors > 0
+		? tr("%1 logical processors").arg(logical_processors)
+		: tr("Processor count unavailable");
+	auto* system_summary = new QLabel(
+		tr("System overview (not a compatibility guarantee): %1, %2, %3.")
+			.arg(QSysInfo::prettyProductName(), QSysInfo::currentCpuArchitecture(), cpu_summary)
+		+ QStringLiteral("<br/><span dir=\"rtl\">معلومات النظام (لا تضمن التوافق): %1، %2، %3.</span>")
+			.arg(QSysInfo::prettyProductName(), QSysInfo::currentCpuArchitecture(), cpu_summary),
+		setup_group);
+	system_summary->setWordWrap(true);
+	system_summary->setTextFormat(Qt::RichText);
+	setup_layout->addWidget(system_summary);
+
+	if (auto* window = qobject_cast<main_window*>(parent))
+	{
+		connect(firmware_button, &QPushButton::clicked, window, [window]() { main_window::InstallPup(window); });
+		connect(games_button, &QPushButton::clicked, window, &main_window::OpenGameFolderPicker);
+		connect(controller_button, &QPushButton::clicked, window, &main_window::OpenControllerSettings);
+	}
+	else
+	{
+		firmware_button->setEnabled(false);
+		games_button->setEnabled(false);
+		controller_button->setEnabled(false);
+	}
+
+	ui->layout_bottom->insertWidget(0, setup_group);
